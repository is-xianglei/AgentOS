# ------------------------- LOGGING - BEGIN  -------------------------
# 根日志级别(DEBUG/INFO/WARNING/ERROR/CRITICAL,非法值启动即报错)
AGENTOS_LOG_LEVEL=INFO
# ------------------------- LOGGING - END  -------------------------

# ------------------------- LLM - BEGIN  -------------------------
# 全局 Provider 开关(必填,无默认值;可选值 anthropic / openai,缺失则启动自检报错)
AGENTOS_LLM_PROVIDER=anthropic
AGENTOS_ANTHROPIC_BASE_URL=https://4sapi.com
AGENTOS_ANTHROPIC_API_KEY=sk-***
# Anthropic 主模型,所有场景未配置覆盖时回落到此
AGENTOS_ANTHROPIC_MODEL=claude-opus-4-6-thinking
# Anthropic SDK 内置重试次数与超时(秒);超时留空表示交给 SDK 自动计算
AGENTOS_ANTHROPIC_MAX_RETRIES=2
AGENTOS_ANTHROPIC_TIMEOUT_SECONDS=
# Anthropic 场景覆盖(留空回落主模型)
AGENTOS_ANTHROPIC_AGENT_MODEL=
AGENTOS_ANTHROPIC_SUBAGENT_MODEL=
AGENTOS_ANTHROPIC_SUBAGENT_FAST_MODEL=
AGENTOS_ANTHROPIC_COMPACT_MODEL=
AGENTOS_ANTHROPIC_MEMORY_SELECTOR_MODEL=
AGENTOS_ANTHROPIC_MEMORY_EXTRACTOR_MODEL=
AGENTOS_ANTHROPIC_MEMORY_DREAM_MODEL=
# 扩展思考(默认关:开启会改变成本与延迟);预算需 >=1024 且 < DEFAULT_MAX_TOKENS
AGENTOS_ANTHROPIC_THINKING_ENABLED=false
AGENTOS_ANTHROPIC_THINKING_BUDGET_TOKENS=4096
# OpenAI 配置(仅 AGENTOS_LLM_PROVIDER=openai 时 api_key 与主模型必填)
AGENTOS_OPENAI_API_KEY=
AGENTOS_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_OPENAI_MODEL=
AGENTOS_OPENAI_MAX_RETRIES=2
AGENTOS_OPENAI_TIMEOUT_SECONDS=
# OpenAI 场景覆盖(留空回落主模型)
AGENTOS_OPENAI_AGENT_MODEL=
AGENTOS_OPENAI_SUBAGENT_MODEL=
AGENTOS_OPENAI_SUBAGENT_FAST_MODEL=
AGENTOS_OPENAI_COMPACT_MODEL=
AGENTOS_OPENAI_MEMORY_SELECTOR_MODEL=
AGENTOS_OPENAI_MEMORY_EXTRACTOR_MODEL=
AGENTOS_OPENAI_MEMORY_DREAM_MODEL=
# 思考模式(DeepSeek 私有扩展,标准 OpenAI 端点会拒,默认关)
AGENTOS_OPENAI_THINKING_ENABLED=false
AGENTOS_OPENAI_REASONING_EFFORT=
# LLM 调用通用配置:流式 max_tokens 与各结构化场景 max_tokens
AGENTOS_LLM_DEFAULT_MAX_TOKENS=131072
AGENTOS_LLM_MEMORY_SELECTOR_MAX_TOKENS=256
AGENTOS_LLM_MEMORY_EXTRACTOR_MAX_TOKENS=4096
AGENTOS_LLM_MEMORY_DREAM_MAX_TOKENS=8192
# 工具调用上限-防止模型在工具循环里无限调用
AGENTOS_MAX_TOOL_ITERATIONS=50
# ------------------------- LLM - END  -------------------------

# ------------------------- SubAgent - BEGIN  -------------------------
# 模型档位配置已并入 LLM Provider 组(AGENTOS_ANTHROPIC_SUBAGENT_MODEL 等)
# ReAct 轮次上限-按类型分档
AGENTOS_SUBAGENT_MAX_ROUNDS=6
AGENTOS_SUBAGENT_PLAN_MAX_ROUNDS=12
# verification 须跑构建+测试+lint+对抗探测-轮次显著放宽
AGENTOS_SUBAGENT_VERIFICATION_MAX_ROUNDS=24
# 每会话并发子代理上限-防止无限 spawn 导致资源失控
AGENTOS_SUBAGENT_MAX_CONCURRENCY=3
# ------------------------- SubAgent - END  -------------------------


# ------------------------- DATABASE - BEGIN  -------------------------
# 应用和 PostgreSQL 集成测试统一使用此数据库连接。
AGENTOS_DATABASE_URL=postgresql+psycopg://<用户名>:<密码>@<主机>:5432/agentos
# ------------------------- DATABASE - END  -------------------------


# ------------------------- REDIS - BEGIN  -------------------------
AGENTOS_REDIS_URL=redis://:<密码>@<主机>:6379/0
AGENTOS_REDIS_PASSWORD=
AGENTOS_DISABLE_REDIS_EVENTS=0
# ------------------------- REDIS - END  -------------------------


# ------------------------- DEBUG - BEGIN  -------------------------
AGENTOS_TEAM_TASK_DEBUG_ISOLATION=1
AGENTOS_INSTANCE_ID=local-dev
AGENTOS_CREATE_TABLES=False
# ------------------------- DEBUG - END  -------------------------


# ------------------------- MINIO - BEGIN  -------------------------
AGENTOS_MINIO_ENDPOINT=localhost:9000
AGENTOS_MINIO_ACCESS_KEY=<access_key>
AGENTOS_MINIO_SECRET_KEY=<secret_key>
AGENTOS_MINIO_BUCKET=skills
AGENTOS_MINIO_SECURE=false
# ------------------------- MINIO - END  -------------------------


# ------------------------- SKILL - BEGIN  -------------------------
AGENTOS_SKILL_EXEC_ENABLED=True
AGENTOS_SKILL_EXEC_TIMEOUT=30
AGENTOS_SKILL_EXEC_MAX_OUTPUT=65536
# ------------------------- SKILL - END  -------------------------


# ------------------------- MEMORY - BEGIN  -------------------------
# Selector/Extractor/Dream 的模型配置已并入 LLM Provider 组
# (AGENTOS_ANTHROPIC_MEMORY_SELECTOR_MODEL 等)
AGENTOS_MEMORY_SELECTOR_TIMEOUT_SECONDS=5.0
AGENTOS_MEMORY_SELECTOR_QUERY_MAX_CHARS=12000
AGENTOS_MEMORY_RECALL_MAX_ITEMS=5
AGENTOS_MEMORY_RECALL_ITEM_MAX_BYTES=4096
AGENTOS_MEMORY_RECALL_ITEM_MAX_LINES=200
AGENTOS_MEMORY_SESSION_MAX_BYTES=61440
AGENTOS_MEMORY_EXTRACTION_ENABLED=true
AGENTOS_MEMORY_EXTRACTION_INLINE=true
AGENTOS_MEMORY_EXTRACTOR_TIMEOUT_SECONDS=20
AGENTOS_MEMORY_EXTRACTOR_PROMPT_VERSION=v1
AGENTOS_MEMORY_EXTRACTOR_MAX_MESSAGES=10
AGENTOS_MEMORY_EXTRACTOR_MAX_CHARS=20000
AGENTOS_MEMORY_EXTRACTOR_MAX_ITEMS=5
AGENTOS_MEMORY_JOB_MAX_ATTEMPTS=5
AGENTOS_MEMORY_JOB_LEASE_SECONDS=300
AGENTOS_MEMORY_JOB_CLAIM_BATCH_SIZE=10
AGENTOS_MEMORY_WORKER_POLL_SECONDS=1
AGENTOS_MEMORY_DREAM_ENABLED=true
AGENTOS_MEMORY_DREAM_TIMEOUT_SECONDS=60
AGENTOS_MEMORY_DREAM_PROMPT_VERSION=v1
AGENTOS_MEMORY_DREAM_MIN_ITEMS=10
AGENTOS_MEMORY_DREAM_MIN_SESSIONS=5
AGENTOS_MEMORY_DREAM_INTERVAL_SECONDS=86400
AGENTOS_MEMORY_DREAM_SCAN_INTERVAL_SECONDS=3600
AGENTOS_MEMORY_DREAM_LEASE_SECONDS=3600
AGENTOS_MEMORY_DREAM_MAX_INPUT_CHARS=120000
AGENTOS_MEMORY_DREAM_MAX_OPERATIONS=100
AGENTOS_MEMORY_RETENTION_ENABLED=true
AGENTOS_MEMORY_ARCHIVED_ITEM_RETENTION_DAYS=90
AGENTOS_MEMORY_TERMINAL_JOB_RETENTION_DAYS=30
AGENTOS_MEMORY_RETENTION_BATCH_SIZE=100
AGENTOS_MEMORY_RETENTION_INTERVAL_SECONDS=3600
# 修改 salt 会重新分桶，生产环境启用灰度后应保持稳定
AGENTOS_MEMORY_ROLLOUT_SALT=agentos-memory-v1
# 保守默认值为 0，需按灰度计划逐步调大（0=全部跳过，100=全量放开）
AGENTOS_MEMORY_RECALL_ROLLOUT_PERCENT=0
AGENTOS_MEMORY_DREAM_ROLLOUT_PERCENT=0
# 影子提取仍调用模型并校验输出，但不会写入 Memory 或推进 Dream；默认开启影子期
AGENTOS_MEMORY_EXTRACTION_SHADOW_ENABLED=true
# ------------------------- MEMORY - END  -------------------------


# ------------------------- JWT 认证 - BEGIN  -------------------------
AGENTOS_JWT_SECRET_KEY=<请替换为随机生成的强密钥>
AGENTOS_JWT_ALGORITHM=HS256
AGENTOS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AGENTOS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# ------------------------- JWT 认证 - END  -------------------------
